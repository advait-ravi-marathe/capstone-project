FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app
WORKDIR /app

COPY requirements-fde-v2-api.txt /tmp/requirements-fde-v2-api.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
    -r /tmp/requirements-fde-v2-api.txt
COPY ai/fde_v2 /app/ai/fde_v2

EXPOSE 8765
HEALTHCHECK --interval=5s --timeout=2s --start-period=10s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=1).read()"
CMD ["python", "-m", "uvicorn", "ai.fde_v2.coverstory.api:app", "--host", "0.0.0.0", "--port", "8765"]
