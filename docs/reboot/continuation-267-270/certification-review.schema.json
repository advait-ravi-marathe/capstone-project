{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline certification readiness evidence for closeout",
  "description": "Learner-authored evidence only; absence is not a failed credential. The result can at most support a separate booking review. It never proves exam pass or authorizes booking.",
  "type": "object",
  "additionalProperties": false,
  "required": ["guide_title", "guide_version", "guide_checked_on", "full_length_official_exam_available", "full_length_availability_note", "domains", "attempts"],
  "properties": {
    "guide_title": {"type": "string", "minLength": 1},
    "guide_version": {"type": "string", "minLength": 1},
    "guide_checked_on": {"type": "string", "format": "date"},
    "full_length_official_exam_available": {"type": "boolean"},
    "full_length_availability_note": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attempts": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["attempt_id", "attempted_on", "material_title", "material_url", "material_type", "timed", "full_length_official", "correct", "total", "domain_scores", "missed_topics", "reviewed_missed_topics", "unstudied_domains"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "attempted_on": {"type": "string", "format": "date"},
          "material_title": {"type": "string", "minLength": 1},
          "material_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "material_type": {"const": "current_official_practice"},
          "timed": {"type": "boolean", "const": true},
          "full_length_official": {"type": "boolean"},
          "correct": {"type": "integer", "minimum": 0},
          "total": {"type": "integer", "minimum": 1},
          "domain_scores": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}}]},
          "missed_topics": {"type": "array", "items": {"type": "string"}},
          "reviewed_missed_topics": {"type": "array", "items": {"type": "string"}},
          "unstudied_domains": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
