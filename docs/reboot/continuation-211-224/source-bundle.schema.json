{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic clause bundle for Days 211–224",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "version", "records"],
  "properties": {
    "bundle_id": {"type":"string","const":"synthetic-policy-explanations"},
    "version": {"type":"string","pattern":"^v[1-9][0-9]*$"},
    "records": {"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["source_id","version","owner_id","status","text"],"properties":{"source_id":{"type":"string","pattern":"^synthetic-policy-[0-9]{3}$"},"version":{"type":"string","pattern":"^v[1-9][0-9]*$"},"owner_id":{"type":"string","pattern":"^owner-[a-z0-9-]{1,32}$"},"status":{"enum":["approved","draft"]},"text":{"type":"string","minLength":1,"maxLength":512}}}}
  }
}
