{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One learner-authored AWS guide review record (create two files)",
  "type": "object",
  "required": ["day", "reviewed_at", "credential", "guide_title", "guide_version", "source_url", "domain_headings", "study_minutes", "learner_notes", "assistance"],
  "properties": {
    "day": {"const": 207},
    "reviewed_at": {"type": "string", "format": "date"},
    "credential": {"enum": ["SAA-C03", "AWS Certified Developer - Associate"]},
    "guide_title": {"type": "string", "minLength": 1},
    "guide_version": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "domain_headings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "study_minutes": {"type": "integer", "minimum": 0, "maximum": 35},
    "learner_notes": {"type": "string", "minLength": 1},
    "assistance": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
