{
  "openapi": "3.2.1",
  "info": {"title": "CoverStory synthetic policy API", "version": "1.0.0"},
  "paths": {
    "/api/policies": {
      "post": {
        "operationId": "issuePolicy",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PolicyIssueRequest"}}}},
        "responses": {
          "200": {"description": "Idempotent replay", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PolicySnapshot"}}}},
          "201": {"description": "Issued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PolicySnapshot"}}}},
          "400": {"description": "Rejected request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
          "401": {"description": "Unauthenticated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
          "404": {"description": "Quote or request reference not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
          "409": {"description": "Conflicting idempotency request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/policies/{policyId}": {
      "get": {
        "operationId": "readPolicy",
        "parameters": [{"name": "policyId", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Owner-scoped snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PolicySnapshot"}}}},
          "401": {"description": "Unauthenticated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
          "404": {"description": "Not found or not owned", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PolicyIssueRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["journeyId", "quoteVersionId", "clientRequestId", "effectiveDate"],
        "properties": {
          "journeyId": {"type": "string"}, "quoteVersionId": {"type": "string"},
          "clientRequestId": {"type": "string"}, "effectiveDate": {"type": "string", "format": "date"}
        }
      },
      "PolicySnapshot": {
        "type": "object", "required": ["policyId", "ownerId", "journeyId", "quoteVersionId", "currency", "status", "version", "endorsements"],
        "properties": {
          "policyId": {"type": "string"}, "ownerId": {"type": "string"}, "journeyId": {"type": "string"},
          "quoteVersionId": {"type": "string"}, "productVersion": {"type": "string"}, "rateVersion": {"type": "string"},
          "annualPremiumRupees": {"type": "number"}, "currency": {"type": "string"}, "effectiveDate": {"type": "string", "format": "date"},
          "status": {"type": "string", "enum": ["ISSUED", "CANCEL_SCHEDULED", "CANCELLED"]},
          "version": {"type": "integer", "format": "int64"},
          "endorsements": {"type": "array", "items": {"$ref": "#/components/schemas/PolicyEndorsement"}},
          "cancellationEffectiveDate": {"type": ["string", "null"], "format": "date"}
        }
      },
      "PolicyEndorsement": {
        "type": "object", "required": ["version", "effectiveDate", "changeCode", "trainingRebuildAmountRupees"],
        "properties": {
          "version": {"type": "integer", "format": "int64"},
          "effectiveDate": {"type": "string", "format": "date"},
          "changeCode": {"type": "string"},
          "trainingRebuildAmountRupees": {"type": "number"}
        }
      },
      "ApiError": {"type": "object", "required": ["code"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}
    }
  }
}
