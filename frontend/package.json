{
  "name": "coverstory-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:local": "tsc --noEmit && vite build --config vite.local.config.ts",
    "test": "vitest run && node --test e2e/api-capture-merge.test.mjs",
    "test:local": "RUN_LEARNER_ACCEPTANCE=true vitest run src/__tests__/LocalCoverStoryApp.test.tsx",
    "test:model-integration": "RUN_MODEL_INTEGRATION_ACCEPTANCE=true vitest run src/local/ModelPredictionPanel.test.tsx",
    "test:model-integration-witness": "RUN_MODEL_INTEGRATION_WITNESS=true vitest run src/local/ModelPredictionPanel.witness.test.tsx",
    "test:fde-v2": "RUN_FDE_V2=true vitest run",
    "test:watch": "vitest",
    "test:learner": "RUN_LEARNER_ACCEPTANCE=true vitest run",
    "test:sprint5": "RUN_LEARNER_ACCEPTANCE=true vitest run src/__tests__/LocalCoverStoryApp.test.tsx -t 'offers only fixed synthetic owners|uses the same-origin session and shows read-only preview as reference only|issues, reads back and replays with the same client request ID|returns explicit error states for malformed and rejected responses|locks a pending issue, does not retry a failed POST, and handles bodyless logout|clears preview on owner change and ignores the late prior-owner response'"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
